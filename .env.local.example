# Copia este archivo a ".env.local" (no se sube al repo, ver .gitignore) y
# llena los valores reales de tu proyecto de Firebase para desarrollar contra
# el registro compartido. Sin este archivo, "npm run dev" sigue funcionando
# en modo local (solo en este navegador) — ver README, "Modo compartido".
#
# Los valores salen de Firebase Console → Configuración del proyecto →
# tus apps → app web → "Config del SDK". No son secretos (la protección real
# la dan las reglas de Firestore + que solo existe una cuenta en Auth), pero
# igual no conviene commitearlos: así cada quien puede apuntar a su propio
# proyecto de prueba sin pisar el de producción.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# El correo de la única cuenta de Firebase Auth del proyecto (la clave del
# grupo es su contraseña, capturada en Firebase Console → Authentication →
# Users). No hace falta que sea un correo real, solo tener ese formato.
VITE_FIREBASE_SHARED_EMAIL=
